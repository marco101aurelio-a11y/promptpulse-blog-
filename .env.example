# Exemplo de configuração de variáveis de ambiente
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_MODEL=deepseek/deepseek-chat
PEXELS_API_KEY=sua_chave_pexels_aqui

# WordPress REST API (opcional)
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=

DEFAULT_LANGUAGE=pt

# Google Analytics 4 (Data API)
# Arquivo JSON da conta de serviço baixado do Google Cloud Console
GOOGLE_APPLICATION_CREDENTIALS=projeto-blog-automatico-494221-a5d1909a3d90.json
# ID numérico da Propriedade no GA4 (ex: 471234567, encontrado em GA4 > Administrador > Detalhes da Propriedade)
GA_PROPERTY_ID=
